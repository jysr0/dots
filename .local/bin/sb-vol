#!/bin/sh

# 󰕿 󰖀 󰕾 󰸈 󰖁 󰝟 󰝞 󰝝 󱄠 󱄡 #SINK
# 󰍬 󰍮 󰢳 󰢴 󰍭 󱦉 󱦊 󰍯 󰍰 󰍱 #SOURCE

# try $BLOCK_BUTTON and $BUTTON
case $BLOCK_BUTTON in
	1) pamixer -t;;
	#2) pamixer --set-volume 100;;
	3) pamixer --set-volume   0;;
	4) pamixer -d 2;; 
	5) pamixer -i 2;; 
esac

mute="$(pamixer --get-mute)"
vol="$(pamixer --get-volume)"

if [[ $mute == "true" ]]; then
	printf "󰕿muted" && exit
fi

case $vol in
	0) printf "󰕿   $vol%%";;
	[1-9]) printf "󰖀   $vol%%";;
	[1-3][0-9]) printf "󰖀  $vol%%";;
	[4-9][0-9]) printf "󰕾  $vol%%";;
	100) printf "󰕾 $vol%%";;
esac
