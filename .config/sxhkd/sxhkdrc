#CLIPBOARD
#super + alt + v
super + v
	clipmenu
#super + alt + v
super + shift + v
	clipdel -d '.*' && notify-send 'Clipboard cleared'

#EMOJIS & ICONS
super + alt + {_,shift +} g
	{emoji.sh,icon.sh}

#WALLPAPER
super + alt + {_,shift +} b
	{wallpaper.sh,wallpaper_random.sh}

#SCREENSHOT
{super + Print,Print}
	{flameshot full -c -p $XDG_PICTURES_DIR,flameshot gui -c -p $XDG_PICTURES_DIR}

