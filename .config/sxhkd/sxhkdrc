# CLIPBOARD VIEW
#super + alt + v
super + v
	clipmenu
# CLIPBOARD CLEAR
#super + alt + v
super + shift + v
	clipdel -d '.*' && notify-send 'Clipboard cleared'



# EMOJIS
super + alt + e
	dmenu_emojis.sh

# ICONS
super + alt + i
	dmenu_icons.sh



# BACKGROUND SET
super + alt + b
	dmenu_bg.sh
# BACKGROUND RANDOM SET
super + alt + w
	random_bg.sh

# SCREEN SHOT
{super + Print,Print}
	{flameshot screen && notify-send 'Fullscreen taken',flameshot gui && notify-send 'Screenshot taken'}






# SIGNALS TO DWMBLOCKS
# keyboard
alt + space
	kill -43 $(pidof dwmblocks)
# clock at wakeup
@XF86WakeUp
	kill -41 $(pidof dwmblocks)






# LOCKSCREEN
super + shift + ctrl + q
	xscreensaver-command -quiet -lock

# POWERMENU
super + alt + x
	dmenu_powermenu.sh




