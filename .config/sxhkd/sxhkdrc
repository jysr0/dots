# TERMINAL
super + Return
	$TERMINAL

# BROWSER
super + w
	$BROWSER

# FILE MANAGER
super + e
	$TERMINAL -e lfub

# GIMP
super + g
	gimp

# APP MENU
super + r
	rofi -show drun




# BRIGHTNESS
XF86MonBrightness{Up,Down}
	brightnessctl -q -e2 -n10 s {5%+,5%-} && kill -36 $(pidof dwmblocks)

# VOLUME
XF86Audio{Mute,RaiseVolume,LowerVolume}
#	pamixer {-t,-i,-d} 2 && pkill -RTMIN+5 dwmblocks
	pamixer {-t,-i,-d} 2 && kill -39 $(pidof dwmblocks)
