# TERMINAL
super + Return
	$TERMINAL

# BROWSER
super + w
	$BROWSER

# FILE MANAGER
super + e
	$TERMINAL -e lfub

# GIMP
super + g ; o
	gimp





# CLIPBOARD VIEW
#super + alt + v
super + v
	clipmenu
# CLIPBOARD CLEAR
#super + alt + v
super + shift + v
	clipdel -d '.*' && notify-send 'Clipboard cleared'



# EMOJIS
super + alt + e
	dmenu_emojis.sh

# ICONS
super + alt + i
	dmenu_icons.sh



# BACKGROUND SET
super + alt + b
	dmenu_bg.sh
# BACKGROUND RANDOM SET
super + alt + w
	random_bg.sh

# SCREEN SHOT
{super + Print,Print}
	{flameshot screen && notify-send 'Fullscreen taken',flameshot gui && notify-send 'Screenshot taken'}



# LOCKSCREEN
super + F12
	slock

# POWERMENU
super + alt + x
	dmenu_powermenu.sh

