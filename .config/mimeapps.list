#look for `.desktop` files in: /usr/share/applications or ~/.local/share/applications
[Default Applications]
x-scheme-handler/http=brave-browser.desktop
x-scheme-handler/https=brave-browser.desktop

application/xhtml+xml=brave-browser.desktop
application/x-xpinstall=brave-browser.desktop
#application/pdf=org.pwmt.zathura-pdf-poppler.desktop
#application/pdf=org.pwmt.zathura.desktop
application/pdf=zathura.desktop
#application/x-gnome-saved-search=nemo.desktop

#inode/directory=lf.desktop

image/*=sxiv.desktop
image/jpeg=sxiv.desktop
image/png=sxiv.desktop
image/gif=sxiv.desktop
image/webp=sxiv.desktop

audio/*=vlc.desktop
audio/ogg=vlc.desktop
audio/opus=vlc.desktop
audio/mp4=vlc.desktop
audio/webm=vlc.desktop
audio/mpeg=vlc.desktop
audio/x-m4a=vlc.desktop

video/*=vlc.desktop
video/mp4=vlc.desktop
video/webm=vlc.desktop
video/mpeg=vlc.desktop
video/ogg=vlc.desktop

#text/*=vim.desktop
text/x-shellscript=vim.desktop
text/plain=vim.desktop
#text/markdown=vim.desktop
#text/css=vim.desktop
text/csv=vim.desktop
text/tab-separated-values=vim.desktop
#text/html=vim.desktop
#text/javascript=vim.desktop
#text/rust=vim.desktop



