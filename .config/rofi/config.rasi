configuration {
/* ALL OPTIONS BELLOW ARE MIX OF DIFFERENT ROFI MAN PAGES:
 * rofi
 * rofi-actions (5)
 * rofi-keys (5)
 * rofi-theme (5)
 */

/*
 * If you have a theme loaded via @theme
   or using default theme, you can
   tweak it by adding overriding elements
   at the end of config.rasi file.
 * use ?import if you want no error when the file does not exists
 * -theme option is same as @theme
 * if single theme file is used .rasi extension is preffered 
 * if a single theme file is split up to multiple theme files
   `.rasinc` extension is preffered
 * see: man rofi-theme (5) 
 */

// ?import "" /* ? for report no error if file isn't found */
// @import "" /* see: rofi-theme (5) `Multiple file handling` */

/*
 * rofi options can be set here as:
   option: "-dpi 'num'"
   will be: "dpi: 'num'"
   in the configuration file config.rasi
 * and for boolean options as(this method is not recommended):
   option: "-sort"
   will be: "sort: true" and "-no-sort"  will be: "sort: false"
*/

/*	display: 0; */
	dmenu: true;
	config: "~/.config/rofi/config.rasi";
	no-lazy-grab: false;
	normal-window: false;
/*	markup: false;*/
	no-plugins: true;
/*	plugin-path: ;*/
	transient-window: true;
/*	theme: "~/.config/rofi/themes/default.rasi"; it is same as @theme bellow*/
	selected-row: 0;

/*	monitor: "primary,xrandr,(integer num in order of detection),(negative nums from -1..-5)"; see: man rofi*/
/*	monitor: -5;*/
/*	m: ;*/

/*	about modes:
 *  window: rofi shows all opened windows in all workspaces.
 *  windowcd: rofi shows all opened windows but only in current working workspace.
 *  run: rofi shows all executables in $PATH env variable.
 *  drun: rofi shows all executables that have installed (.desktop) desktop files.
 */
/*	modes: "window,windowcd,drun,run,ssh,keys,script,combi,filebrowser,recursivefilebrowser";*/
	modes: "drun,run,window,keys";
	/*
 	/* {mode} one of `modes` */
    {mode} { 
      display-name: "";
    }
    */	
	/*
    drun {
       // Scan the current users desktop for desktop files.
       scan-desktop: true;
       // Parse user desktop files.
       parse-user:   true;
       // Parse system desktop files. 
       parse-system: false;
       // Disable DBusActivatable 
       DBusActivatable: false;
    }
    */
	combi-hide-mode-prefix: false;
	combi-modes: "run,keys"; /* `modes` must be: combi */
	combi-display-format: "{mode}: {text}"; /* {mode} is one of the modes in `combi-modes` */
   	
	font: "mono 10";
	location: 0;
/*	yoffset: 0;*/
/*	xoffset: 0;*/
	fixed-num-lines: true;
	show-icons: true;
/*	preview-cmd: ;*/

/*	on-selection-changed: ;*/
/*	on-mode-changed: ;*/
/*	on-entry-accepted: ;*/
/*	on-menu-canceled: ;*/
/*	on-menu-error: ;*/
/*	on-screenshot-taken: ;*/

	terminal: "rofi-sensible-terminal";
/*	terminal: ${TERMINAL};*/

/*	ssh-client: "ssh";*/
/*	ssh-command: "{terminal} -e {ssh-client} {host} [-p {port}]";*/
/*	run-command: "{cmd}";*/
/*	run-list-command: "";*/
/*	run-shell-command: "{terminal} -e {cmd}";*/
/*	window-command: "wmctrl -i -R {window}";*/
	
//	window-match-fields: "title,class,role,name,desktop,all"; /* for X11 */
//	window-match-fields: "title,app-id,class,all"; /* for wayland */
	window-match-fields: "all";

/*	icon-theme: Adwaita-Dark;*/
/*	icon-theme: hicolor;*/

/*	drun-match-fields: "name,generic,exec,categories,comments,all,keywords";*/
	drun-match-fields: "name,generic,exec,categories,keywords";
/*	drun-categories: ;*/
/*	drun-exclude-categories: ;*/
	drun-show-actions: false;
/*	drun-display-format: "{name},{generic},{exec},{categories},{comment},{url}"; pango markup can be used*/
/*	drun-display-format: "{name} [<span weight='light' size='small'><i>({generic})</i></span>]";*/
	drun-display-format: "{name}";
	drun-url-launcher: "xdg-open";

	disable-history: true;
	max-history-size: 10;
/*	ignored-prefixes: "";*/
	sort: false;
	
/*	sorting-method: "normal";*/
/*	sorting-method: "levenshtein,fzf";*/
	sorting-method: "levenshtein";
	
	case-sensitive: false;
	case-smart: false;
	cycle: false;
	sidebar-mode: false;
	hover-select: false;
	eh: 1;
	auto-select: false;
	parse-hosts: false;
	parse-known-hosts: true;

/*	matching: "normal,regex,glob,fuzzy,prefix";*/
	matching: "normal";
	
	tokenize: true;
/*	m: "-5";*/
/*	filter: ;*/
	
/*	dpi: -1;*/
//	dpi: 1; /* 0: auto-detect based on X11 screen size, 1: auto-detect based on monitor size rofi displayed on */
//	dpi: 0; /* 0 or 1 for wayland */

/*	threads: 0;*/
	scroll-method: 0;
	
/*	window-format: "{w:0} {c} {t}	{n}	{r}"; {field[:length]} length: 0: auto-detect, negative: unchanged, positive: truncated/padded*/
/*	window-format: "{n:0}: {t:0}";*/
	window-format: "{t:0} - {n:0}";

	click-to-exit: true;
	global-kb: false;
/*	matching-negate-char: '-' /* unsupported */;*/
/*	cache-dir: "~/.cache/rofi";*/
	window-thumbnail: false;
	drun-use-desktop-cache: false; /* enable for slow hard drives */
	drun-reload-desktop-cache: false; /* enable if `drun-use-desktop-cache` is enabled */
	normalize-match: false;
	steal-focus: false;
/*	application-fallback-icon: ;*/
	refilter-timeout-limit: 300; /*milli-seconds*/
/*	xserver-i300-workaround: false;*/
/*	completer-mode: "filebrowser";*/
/*	imdkit: true;*/
	pid: "/run/user/1000/rofi.pid"; /* use if rofi is launched via keybinding daemon like sxhkd */
	replace: false;

/*	display-window: ;*/
/*	display-run: ;*/
/*	display-ssh: ;*/
/*	display-drun: ;*/
/*	display-combi: ;*/
/*	display-keys: ;*/
/*	display-filebrowser: ;*/
/*	display-recursivebrowser: ;*/

//	append '!' before keybinding so rofi act upon releasing
//	pass an empty string to a keybinding to unset it: kb-primary-paste: "";

/*	kb-primary-paste: "Control+V,Shift+Insert";*/
	kb-primary-paste: "Control+V";
/*	kb-secondary-paste: "Control+v,Insert";*/
	kb-secondary-paste: "Control+v";
	kb-secondary-copy: "Control+c";
	kb-clear-line: "Control+w";
	kb-move-front: "Control+a";
	kb-move-end: "Control+e";
	kb-move-word-back: "Alt+b,Control+Left";
	kb-move-word-forward: "Alt+f,Control+Right";
	kb-move-char-back: "Left,Control+b";
	kb-move-char-forward: "Right,Control+f";
/*	kb-remove-word-back: "Control+Alt+h,Control+BackSpace";*/
	kb-remove-word-back: "Control+Alt+h,Alt+BackSpace";
/*	kb-remove-word-forward: "Control+Alt+d";*/
	kb-remove-word-forward: "Control+Alt+d,Alt+d";
/*	kb-remove-char-forward: "Delete,Control+d";*/
	kb-remove-char-forward: "Control+d";
	kb-remove-char-back: "BackSpace,Shift+BackSpace,Control+h";
	kb-remove-to-eol: "Control+k";
	kb-remove-to-sol: "Control+u";
/*	kb-accept-entry: "Control+j,Control+m,Return,KP_Enter";*/
/*	kb-accept-entry: "space,Return,KP_Enter";*/
    kb-accept-entry: "Return,KP_Enter";
	kb-accept-custom: "Control+Return";
	kb-accept-custom-alt: "Control+Shift+Return";
	kb-accept-alt: "Shift+Return";
	kb-delete-entry: "Shift+Delete";
	kb-mode-next: "Shift+Right,Control+Tab";
	kb-mode-previous: "Shift+Left,Control+ISO_Left_Tab";
	kb-mode-complete: "Control+l";
	kb-row-left: "Control+Page_Up";
	kb-row-right: "Control+Page_Down";
	kb-row-up: "Up,Control+p";
	kb-row-down: "Down,Control+n";
/*	kb-row-tab: "";*/
/*	kb-element-next: "Tab";*/
/*	kb-element-prev: "ISO_Left_Tab";*/
/*	kb-page-prev: "Page_Up";*/
/*	kb-page-next: "Page_Down";*/
	kb-row-first: "Home,KP_Home";
	kb-row-last: "End,KP_End";
	kb-row-select: "Control+space";
	kb-screenshot: "Alt+S";
	kb-ellipsize: "Alt+period";
	kb-toggle-case-sensitivity: "grave,dead_grave";
	kb-toggle-sort: "Alt+grave";
/*	kb-cancel: "Escape,Control+g,Control+bracketleft";*/
	kb-cancel: "Escape,Control+g";
/*	kb-custom-1: "Alt+1";*/
/*	kb-custom-2: "Alt+2";*/
/*	kb-custom-3: "Alt+3";*/
/*	kb-custom-4: "Alt+4";*/
/*	kb-custom-5: "Alt+5";*/
/*	kb-custom-6: "Alt+6";*/
/*	kb-custom-7: "Alt+7";*/
/*	kb-custom-8: "Alt+8";*/
/*	kb-custom-9: "Alt+9";*/
/*	kb-custom-10: "Alt+0";*/
/*	kb-custom-11: "Alt+exclam";*/
/*	kb-custom-12: "Alt+at";*/
/*	kb-custom-13: "Alt+numbersign";*/
/*	kb-custom-14: "Alt+dollar";*/
/*	kb-custom-15: "Alt+percent";*/
/*	kb-custom-16: "Alt+dead_circumflex";*/
/*	kb-custom-17: "Alt+ampersand";*/
/*	kb-custom-18: "Alt+asterisk";*/
/*	kb-custom-19: "Alt+parenleft";*/
	kb-select-1: "";
	kb-select-2: "";
	kb-select-3: "";
	kb-select-4: "";
	kb-select-5: "";
	kb-select-6: "";
	kb-select-7: "";
	kb-select-8: "";
	kb-select-9: "";
	kb-select-10: "";
	kb-entry-history-up: "Control+Up";
	kb-entry-history-down: "Control+Down";
/*	kb-matcher-up: "Super+equal";*/
/*	kb-matcher-down: "Super+minus";*/
	ml-row-left: "ScrollLeft";
	ml-row-right: "ScrollRight";
	ml-row-up: "ScrollUp";
	ml-row-down: "ScrollDown";
	me-select-entry: "MousePrimary";
	me-accept-entry: "MouseDPrimary";
/*	me-accept-custom: "Control+MouseDPrimary";*/
	me-accept-custom: "Control+Shift+MousePrimary";
  timeout {
      delay:  0; /*seconds*/
      action: "kb-cancel";
  }
  inputchange {
      action: "kb-row-first";
  }
  entry {
      max-history: 30;
  }
  filebrowser {
      /*directory: ;*/
	  directories-first: true;
      show-hidden: false;
      
      /**
        * Sorting method. Can be set to:
        *   - "name"
        *   - "mtime" (modification time)
        *   - "atime" (access time)
        *   - "ctime" (change time)
        */
      sorting-method:    "name";
	  
	  cancel-returns-1: true;
	  command: "xdg-open";
  }
  /*
  recursivebrowser {
      directory: "/some/directory";
     
      /* return 1 on cancel */
      cancel-returns-1: true;
      /* filter entries using regex */
      filter-regex: "(.*cache.*|.*\.o)";
      
      command: "xdg-open";
  }
  */
  /*
  window {
	  close-on-delete: false;
      hide-active-window: true;
      prefer-icon-theme: true; 
  }
  */
}

/* @theme "default" */
@theme "default.rasi" /* it could be a full path */
// @theme "~/.config/rofi/themes/default.rasi" 
